# HTTP server
PORT=8080
# ALLOWED_ORIGIN is available in the configuration, but is not currently used by
# the HTTP router. Keep this value ready for when CORS configuration is enabled.
ALLOWED_ORIGIN=http://localhost:3000

# MongoDB
# Use localhost when running the API on your machine. In Docker Compose, change
# the hostname to the MongoDB service name (for example: mongodb).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=di_eqa

# Redis
# REDIS_URL takes precedence over REDIS_ADDR. Set only one of them.
# REDIS_URL supports hosted Redis URLs, such as redis://:password@host:6379/0.
REDIS_URL=redis://localhost:6379
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# Authentication
# Replace with a long, random secret in every non-local environment.
JWT_SECRET=replace-with-a-long-random-secret

# Public Supabase Storage location used to build quiz image URLs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_BUCKET=images_eqa
